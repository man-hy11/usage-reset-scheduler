#!/usr/bin/env bash
set -Eeuo pipefail

args=" $* "
if [[ "$args" != *" Authorization: Bearer selected-profile-token "* ]]; then
  echo "잘못된 Claude 프로필 토큰 사용" >&2
  exit 42
fi

printf '%s\n' '{"five_hour":{"utilization":12,"resets_at":"2026-09-27T12:00:00+09:00"},"seven_day":{"utilization":34,"resets_at":"2026-10-03T11:00:00+09:00"}}'
